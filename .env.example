# ===================================================
# FarmNexa ENVIRONMENT CONFIGURATION
# ===================================================

# Supabase Credentials (leave blank to run in Demo / Local Persistent Mode)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Only Service Role Key (Never expose to client code)
SERVER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mandi reference prices (AGMARKNET / data.gov.in)
# The government API key is NEVER placed in a VITE_* variable: every VITE_*
# value is bundled into the browser build. Market prices are fetched
# server-side by the Supabase Edge Function `refresh-market-prices`, which
# reads the key from a Supabase secret. Configure it with:
#   supabase secrets set MARKET_API_KEY=<your-data-gov-in-api-key>
# Optional overrides (also Supabase secrets, not VITE_*):
#   MARKET_API_BASE_URL=https://api.data.gov.in/resource
#   MARKET_API_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
#   MARKET_API_STATE_FILTER=Karnataka
#   MARKET_REFRESH_MIN_INTERVAL_MINUTES=10

# Weather API (IMD / Open-Meteo)
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# AI Assistant (Google Gemini API)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Leaflet OpenStreetMap Tile Provider
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Demo Mode Toggle (When true or Supabase unconfigured, uses realistic Karnataka demo data)
VITE_DEMO_MODE=true
