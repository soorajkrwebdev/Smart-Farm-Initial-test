# ===================================================
# SMART FARM ENVIRONMENT CONFIGURATION
# ===================================================

# Supabase Credentials (leave blank to run in Demo / Local Persistent Mode)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Only Service Role Key (Never expose to client code)
SERVER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Open Government Data / Mandi Reference Price API
VITE_MARKET_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
VITE_MARKET_API_KEY=your-data-gov-in-api-key

# Weather API (IMD / Open-Meteo)
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# AI Assistant (Google Gemini API)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Leaflet OpenStreetMap Tile Provider
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Demo Mode Toggle (When true or Supabase unconfigured, uses realistic Karnataka demo data)
VITE_DEMO_MODE=true
